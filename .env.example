# Copy to .env and fill in. Never commit .env.
# Keep this file current: every variable the app reads belongs here, with an
# empty value for anything secret.

SIGNALFORGE_ENV=local
LOG_LEVEL=INFO

# LLM gateway. OpenRouter is the first provider; the gateway resolves roles to
# models, so no model IDs live in code.
OPENROUTER_API_KEY=

# Added in later phases, listed here so the shape is known:
# DATABASE_URL=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
