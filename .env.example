# Copy to .env and fill in. Never commit .env.
# Keep this file current: every variable the app reads belongs here, with an
# empty value for anything secret.

ENVIRONMENT=local
LOG_LEVEL=INFO

# --- PostgreSQL ------------------------------------------------------------
# Session-mode connection, used by the worker and by Alembic. Procrastinate
# needs LISTEN/NOTIFY, which transaction pooling does not support (ADR-0003).
#
# On Supabase use the *session pooler* string (Dashboard -> Connect -> Session
# pooler), NOT the direct db.<ref>.supabase.co host: that one is IPv6-only and
# unreachable without the IPv4 add-on.
#   postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres
# Point this at the DEV project only. Prod credentials never go in a developer
# .env (ADR-0004).
# SUPABASE_DB_STRING is accepted as an alias for existing setups.
DATABASE_URL=

# Optional transaction-mode connection (port 6543) for the API's short
# transactions. Prepared statements must be disabled on it.
# DATABASE_POOLER_URL=

# --- LLM gateway -----------------------------------------------------------
# "fake" needs no credentials and no network. Stages reference roles, never
# model names, so the provider is swappable here alone.
# LLM_PROVIDER is a registry key: "fake" or "openai_compatible" (any API with
# POST /chat/completions: OpenRouter, OpenAI, Ollama, vLLM).
LLM_PROVIDER=fake
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY is accepted as a fallback for LLM_API_KEY.
LLM_API_KEY=
# Example cheap model id; change freely, no code involved.
# LLM_MODEL_RELEVANCE=openai/gpt-4o-mini
# LLM_MODEL_TOPIC_CARD=openai/gpt-4o-mini
# LLM_MODEL_RESEARCH_EXTRACTION=openai/gpt-4o-mini
# Writer and judge must be different vendor namespaces (families).
# LLM_MODEL_ARTICLE_WRITER=anthropic/claude-fable-5.1
# LLM_MODEL_CLAIM_JUDGE=google/gemini-2.5-flash-lite
# Optional vendor-specific request fields, JSON:
# LLM_EXTRA_BODY={"provider": {"require_parameters": true}}
# Output cap per chat call (sent as max_tokens). Default 16384.
# LLM_MAX_OUTPUT_TOKENS=16384
# Extra fields for embedding requests (NVIDIA embed models require input_type):
# LLM_EMBED_EXTRA_BODY={"input_type": "passage"}
# Article writer cap (OpenRouter 402s when credit cannot cover the cap). Default 12000.
# LLM_MAX_OUTPUT_TOKENS_ARTICLE_WRITER=12000
# Texts per embeddings request; 0 (default) sends all in one. Set 1 for hosts that fail on batches.
# LLM_EMBED_BATCH_SIZE=0
# LLM_MODEL_CLAIM_EMBEDDING=openai/text-embedding-3-small
# Route only the article writer to another OpenAI-compatible endpoint, e.g. NVIDIA:
# LLM_WRITER_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_WRITER_API_KEY=   (NVIDIA_API is also read)
# LLM_MODEL_ARTICLE_WRITER=nvidia/nemotron-3-ultra-550b-a55b
# LLM_TIMEOUT_ARTICLE_WRITER_S=180

# --- Search (research stage) -----------------------------------------------
# Tavily key for secondary-source discovery, sent as a Bearer header.
TAVILY_API_KEY=

# --- Budgets ---------------------------------------------------------------
# PRD §12 proposed figures, to calibrate. A stage stops rather than overspend.
BUDGET_PER_TOPIC_USD=0.50
BUDGET_PER_ARTICLE_USD=1.50
# Call caps per card (unset: no cap). Measured 2026-11-15 over 30 days of llm_calls:
# research p95 18.8 / max 27, draft p95 12.1 / max 15. Recommended:
# BUDGET_MAX_CALLS_PER_TOPIC=40
# BUDGET_MAX_CALLS_PER_ARTICLE=30
# USD per million tokens by model id; unlisted models cost 0, and a warning is logged each time
# the LLM gateway is built (not only at startup).
# LLM_PRICES={"vendor/model": {"input": "0.2", "output": "0.6"}}

# --- Supabase (image storage; dashboard auth, Phase 3) ----------------------
# SUPABASE_URL and SUPABASE_SECRET_KEY are read by the API: the API accepts article images only
# from SUPABASE_URL and uploads them with the secret key (POST .../images/upload; unset: 503).
# The JWKS and publishable keys are not read by the backend yet.
# SUPABASE_URL=
# SUPABASE_JWKS_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=

# --- Ingest trigger (temporary, ADR-0005) ----------------------------------
# Off by default. When on, POST /ingest/<source> needs the X-Ingest-Token header.
# Remove when ingest runs through the queue.
INGEST_ENDPOINT_ENABLED=false
INGEST_TOKEN=

# --- Editor decisions ------------------------------------------------------
# Shared key for POST /cards/<id>/decision (X-Editor-Key header). Unset: writes return 503.
# EDITOR_API_KEY=

# Separate revocable key for the automation agent, sent in the same X-Editor-Key header. It opens
# /agent/* and the write endpoints. Unset: the agent has no access. Pause and unpublish rules:
# the editor key always works; the agent key gets 423 on publish while the pipeline is paused.
# AGENT_API_KEY=

# --- Publishing -------------------------------------------------------------
# PUBLISH_BYLINE=SignalForge Editorial
# Pace for agent publishes: at least this many minutes apart, at most this many per 24 hours.
# PUBLISH_MIN_GAP_MINUTES=240
# PUBLISH_DAILY_CAP=3
# SITE_URL and INDEXNOW_KEY: both set turns on the IndexNow ping after a publish.
# SITE_URL=
# INDEXNOW_KEY=

# --- Automatic review and pipeline ------------------------------------------
# AUTO_REVIEW_MIN_WORDS=250
# AUTO_REVIEW_MIN_CLAIMS=3
# AUTO_REVIEW_MAX_FLAGGED_SHARE=0.4
# Redrafts per article, failed ones included; a revise past it is closed.
# AUTO_REVIEW_MAX_REDRAFTS=2
# AUTO_REVIEW_MIN_SECTION_SENTENCES=2
# Keep this false when the cron autopilot runs the pipeline: it accepts cards itself, and an
# accept-triggered pass inside the API would hold the run lock and compete with it.
AUTO_PIPELINE_ON_ACCEPT=false
# AUTO_PIPELINE_DAILY_CAP=10

# --- Cron autopilot (apps/worker/autopilot.py; set on the cron host, not the API) -----------
# It needs only these; never give it DATABASE_URL or LLM keys. See docs/deploy-cron.md.
# API_BASE_URL=
# SIGNALFORGE_KEY=          (the API's AGENT_API_KEY)
# AUTOPILOT_TZ=UTC          (clock for the 00/06/12/18 slots)
# AUTOPILOT_ACCEPT_PER_RUN=2
# SITE_URL=                 (also used by the autopilot to expire the web cache)
# REVALIDATE_SECRET=        (same value as on the web host)
# ALERT_WEBHOOK_URL=        (the autopilot sends the failed-slot alert, the API the pause alert)

# --- Alerts ----------------------------------------------------------------
# Slack- or Discord-compatible incoming webhook for pauses and failed slots. Secret: never
# commit a real URL. Unset: alerts are logged only.
# ALERT_WEBHOOK_URL=
