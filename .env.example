# Copy to .env and fill in. Never commit .env.
# Keep this file current: every variable the app reads belongs here, with an
# empty value for anything secret.

ENVIRONMENT=local
LOG_LEVEL=INFO

# --- PostgreSQL ------------------------------------------------------------
# Session-mode connection, used by the worker and by Alembic. Procrastinate
# needs LISTEN/NOTIFY, which transaction pooling does not support (ADR-0003).
#
# On Supabase use the *session pooler* string (Dashboard -> Connect -> Session
# pooler), NOT the direct db.<ref>.supabase.co host: that one is IPv6-only and
# unreachable without the IPv4 add-on.
#   postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres
# Point this at the DEV project only. Prod credentials never go in a developer
# .env (ADR-0004).
# SUPABASE_DB_STRING is accepted as an alias for existing setups.
DATABASE_URL=

# Optional transaction-mode connection (port 6543) for the API's short
# transactions. Prepared statements must be disabled on it.
# DATABASE_POOLER_URL=

# --- LLM gateway -----------------------------------------------------------
# "fake" needs no credentials and no network. Stages reference roles, never
# model names, so the provider is swappable here alone.
# LLM_PROVIDER is a registry key: "fake" or "openai_compatible" (any API with
# POST /chat/completions: OpenRouter, OpenAI, Ollama, vLLM).
LLM_PROVIDER=fake
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY is accepted as a fallback for LLM_API_KEY.
LLM_API_KEY=
# Example cheap model id; change freely, no code involved.
# LLM_MODEL_RELEVANCE=openai/gpt-4o-mini
# Optional vendor-specific request fields, JSON:
# LLM_EXTRA_BODY={"provider": {"require_parameters": true}}

# --- Budgets ---------------------------------------------------------------
# PRD §12 proposed figures, to calibrate. A stage stops rather than overspend.
BUDGET_PER_TOPIC_USD=0.50
BUDGET_PER_ARTICLE_USD=1.50

# --- Supabase auth (dashboard, Phase 3) ------------------------------------
# Not read by the backend yet. Kept here because they belong to this project.
# SUPABASE_URL=
# SUPABASE_JWKS_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=

# --- Ingest trigger (temporary, ADR-0005) ----------------------------------
# Off by default. When on, POST /ingest/<source> needs the X-Ingest-Token header.
# Remove when ingest runs through the queue.
INGEST_ENDPOINT_ENABLED=false
INGEST_TOKEN=
