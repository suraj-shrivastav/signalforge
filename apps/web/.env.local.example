# Password required to sign in to /editor/*. Set a real value in your own
# untracked .env.local; never commit the real value.
EDITOR_UI_PASSWORD=changeme

# Secret used to sign the editor session cookie. Falls back to
# EDITOR_UI_PASSWORD when unset. Set a real value in your own untracked
# .env.local; never commit the real value.
EDITOR_COOKIE_SECRET=changeme
