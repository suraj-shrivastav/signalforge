# Password required to sign in to /editor/*. Set a real value in your own
# untracked .env.local; never commit the real value. Generate one with
# `openssl rand -base64 32`. Login throws if this is unset, so the gate
# fails closed by default.
EDITOR_UI_PASSWORD=

# Secret used to sign the editor session cookie. Falls back to
# EDITOR_UI_PASSWORD when unset or empty. Set a real, independent value in
# your own untracked .env.local; never commit the real value. Generate one
# with `openssl rand -base64 32`.
EDITOR_COOKIE_SECRET=
