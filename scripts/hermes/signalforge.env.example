# Copy to ~/.signalforge.env (chmod 600). Never commit real keys.
# Read by the launchd fallback scripts in this folder, which the cron autopilot replaces
# (docs/deploy-cron.md). The cron host takes API_BASE_URL, SIGNALFORGE_KEY, SITE_URL,
# REVALIDATE_SECRET, AUTOPILOT_TZ, AUTOPILOT_ACCEPT_PER_RUN and ALERT_WEBHOOK_URL as its own
# environment variables, not from this file.
SIGNALFORGE_KEY=<agent write key>
EDITOR_API_KEY=<editor read key>
API_BASE_URL=https://signalforge-wmtl.onrender.com
# Optional: website URL and shared secret (same value as REVALIDATE_SECRET in Vercel). When set,
# the scheduler expires the site's article cache right after each publish.
SITE_URL=https://signalforge-one-eta.vercel.app
REVALIDATE_SECRET=<random string>
# The settings below are read by the API and the autopilot, not by the launchd scripts. They are
# listed here so the values are kept in one place; set them on the API host (and, for the
# alert URL, the cron host too).
# Optional: Slack- or Discord-compatible incoming webhook for pauses and failed slots. Unset: logs only.
ALERT_WEBHOOK_URL=
# Per-card call caps (unset: no cap). Measured 2026-11-15 over 30 days of llm_calls per stage run:
# research p95 18.8 / max 27, draft p95 12.1 / max 15, assess p95 27 / max 40, cards p95 23 / max 30.
# Recommended (API host):
# BUDGET_MAX_CALLS_PER_TOPIC=40
# BUDGET_MAX_CALLS_PER_ARTICLE=30
# Model prices, USD per million tokens, so cost and the USD caps work. Set real values on the host only.
# LLM_PRICES={"vendor/model": {"input": "0.2", "output": "0.6"}}
