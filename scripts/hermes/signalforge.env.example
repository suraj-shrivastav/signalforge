# Copy to ~/.signalforge.env (chmod 600). Never commit real keys.
SIGNALFORGE_KEY=<agent write key>
EDITOR_API_KEY=<editor read key>
API_BASE_URL=https://signalforge-wmtl.onrender.com
# Optional: website URL and shared secret (same value as REVALIDATE_SECRET in Vercel). When set,
# the scheduler expires the site's article cache right after each publish.
SITE_URL=https://signalforge-one-eta.vercel.app
REVALIDATE_SECRET=<random string>
